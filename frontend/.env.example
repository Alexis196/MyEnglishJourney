# Supabase project settings — Project Settings > API in the Supabase dashboard.
# The anon/public key is safe to expose in the frontend; NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the backend API (see backend/.env.example)
VITE_API_BASE_URL=http://localhost:4000
