# Copy to .env.local for local development (Vercel: set these in Project Settings > Environment Variables).

# --- Supabase (Project Settings > API) ---
# Server-side (API routes)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: NEVER expose to the browser. Reserved for trusted server-side admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Browser-side (same values as above; the anon key is safe to expose, the service role key is NOT)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Gemini — https://aistudio.google.com/app/apikey ---
GEMINI_API_KEY=
# Verified available + priced in src/server/services/ai/pricing.ts as of 2026-09-28. gemini-1.5-* has been retired.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI is OFF by default: with false, no request is ever sent to OpenAI (Gemini only). Server-only variable.
AI_OPENAI_FALLBACK_ENABLED=false

# --- Lesson generation limits ---
# Max AI lesson generations one user can start per rolling 24h (cost safety net; does not block progress).
LESSON_GENERATIONS_PER_DAY=10
# Prepare the next day's lesson in the background when a lesson is completed.
LESSON_PREFETCH_NEXT=true

# --- Live speaking (real-time conversation) ---
GEMINI_LIVE_MODEL=gemini-3.8-live
# Hard cap per conversation, and how many a user can start per rolling 24h.
LIVE_SESSION_MAX_SECONDS=300
LIVE_SESSIONS_PER_DAY=20
# USD/minute charged against the monthly AI budget: 0 while you use the Gemini free tier,
# 0.023 if your API key is billed.
LIVE_COST_PER_MINUTE_USD=0
