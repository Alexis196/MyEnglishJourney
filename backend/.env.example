# Server
NODE_ENV=development
PORT=4000
# Origin allowed by CORS — the frontend's dev server URL (or production domain).
CORS_ORIGIN=http://localhost:5173

# Supabase — Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: NEVER expose this to the frontend. Used only for trusted
# server-side admin tasks (none in Phase 1). Get it from Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI — create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
